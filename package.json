{
  "name": "@velnora/monorepo",
  "version": "0.0.0-dev.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "libs/*",
    "libs/**/*",
    "examples/*",
    "docs"
  ],
  "scripts": {
    "affected:build": "nx affected -t build",
    "affected:lint": "nx affected -t lint",
    "affected:test": "nx affected -t test",
    "build": "nx run velnora:build",
    "changeset:publish": "changeset publish",
    "changeset:version": "changeset version",
    "check:libs:deps": "./scripts/check-libs-deps.sh",
    "dev": "nx run hello-mfe-shell:dev",
    "lint": "nx run-many -t lint",
    "lint:all": "biome lint .",
    "prepare": "nx run-many -t build",
    "test": "vitest --config vitest.config.ts",
    "test:coverage": "vitest --config vitest.config.ts --coverage",
    "typecheck": "nx run-many -t typecheck",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "resolutions": {
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@nx/devkit": "22.7.1",
    "@velnora/internal": "workspace:^"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "^2.31.0",
    "@nx/jest": "22.7.1",
    "@nx/js": "22.7.1",
    "@nx/plugin": "22.7.1",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.33",
    "@swc/helpers": "~0.5.21",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.5",
    "depcheck": "^1.4.7",
    "nx": "^22.7.1",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "vite-node": "^6.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  },
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=22"
  }
}
